# URL printed by `modal deploy modal_trellis2.py` for the `api` Web Function.
TRELLIS2_MODAL_URL=https://<workspace>--stimma-trellis2-api.modal.run

# Required for the gated DINOv3 encoder used by TRELLIS.2. Create this Modal
# secret once with: modal secret create huggingface HF_TOKEN="hf_..."

# Modal Proxy Token used by the Stimma backend. Keep these values server-side.
# The backend also accepts MODAL_PROXY_TOKEN_ID / MODAL_PROXY_TOKEN_SECRET.
TRELLIS2_MODAL_TOKEN_ID=ak-...
TRELLIS2_MODAL_TOKEN_SECRET=as-...

# Optional backend controls.
TRELLIS2_JOB_TIMEOUT_SECONDS=2700
TRELLIS2_GPU=H100
