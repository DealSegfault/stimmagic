#!/bin/sh
set -eu

# Cargo external subcommands may include their own name as argv[1]. The npm
# Tauri CLI does not need it.
if [ "${1-}" = "tauri" ]; then
  shift
fi

INFRA_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$INFRA_ROOT/.." && pwd)"
exec "$REPO_ROOT/frontend/node_modules/.bin/tauri" "$@"
